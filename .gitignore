# Secrets. .env.example is the template and IS committed; .env never is.
.env
.env.*
!.env.example

# Customer data. leads.jsonl holds names and phone numbers, feedback.jsonl
# holds whatever a customer typed into the thumbs-down box, and logs/ holds
# conversation transcripts. server.js and README both said this directory was
# ignored; until 30/08 there was no .gitignore at all, so it was not.
server-data/
logs/

# The commitments workbook and anything derived straight from it. It is the
# company's inventory, not code.
source-data/

# Generated and machine-local
node_modules/
# Test-run output. bank-results.json is 744KB and the live variants are
# regenerated on every run; none of them is source.
tests/bank-results.json
tests/bank-results-live.json
tests/bank-results-live-typical.json

# Saved copies of pingwin.co.il used to reverse-engineer the booking deep link.
# Reference material, not source — checked for secrets before they were first
# committed (30/08) and clean, but they do not belong in code review diffs.
# Remove these three lines if you'd rather keep them tracked.
page.html
page2.html
order.js
*.log
.DS_Store
Thumbs.db
