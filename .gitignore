# Secrets. .env.example is the template and IS committed; .env never is.
.env
.env.*
!.env.example

# Customer data. leads.jsonl holds names and phone numbers, feedback.jsonl
# holds whatever a customer typed into the thumbs-down box, and logs/ holds
# conversation transcripts. server.js and README both said this directory was
# ignored; until 30/08 there was no .gitignore at all, so it was not.
server-data/
logs/

# The commitments workbook and anything derived straight from it. It is the
# company's inventory, not code.
source-data/

# Generated and machine-local
node_modules/
tests/bank-results.json
*.log
.DS_Store
Thumbs.db
