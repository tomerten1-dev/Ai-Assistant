# העתק לקובץ בשם .env ומלא (לא נכנס ל-git)

# ---- מוח הבוט: מלא אחד מהם, או אף אחד ----
# בלי מפתח כלל הבוט עדיין עובד על שכבת העברית הדטרמיניסטית, בחינם.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# הדגם הזול מספיק לגמרי כאן; אפשר gpt-5.6-terra לאיכות גבוהה יותר
OPENAI_MODEL=gpt-5.6-luna

# חלופה: Claude (אם שני המפתחות קיימים, OpenAI מנצח)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ---- הגדרות ----
PORT=8787
# כמה שאלות מותר לבוט לשאול לפני שהוא חייב להציג תוצאות
MAX_QUESTIONS=3
# דומיינים שמותר להם לקרוא ל-API (פסיקים). לפרודקשן: להחליף את הכוכבית!
# רשימת המקורות שמותר להם לפנות לשרת. בפרודקשן — לפרט אותם.
# '*' פותח את השרת לכל אתר, ומכבה גם את בדיקת ה-Origin על POST, ולכן הוא
# מתאים לפיתוח בלבד. הסירו את ההערה מהשורה הראשונה ומחקו את השנייה.
# ALLOWED_ORIGINS=https://www.pingwin.co.il,https://pingwin.co.il
ALLOWED_ORIGINS=*

# ---- לידים ----
# כל ליד נשמר ב-server-data/leads.jsonl, ובנוסף נשלח כ-JSON לכתובת הזו (Make / Zapier /
# Google Sheets / CRM). ריק = שמירה לדיסק בלבד. LEAD_WEBHOOK_SECRET חותם כל בקשה (HMAC-SHA256
# בכותרת x-signature) כדי שהצד המקבל יוכל לוודא שזה מאיתנו.
# LEAD_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxx
#
# הפורמט שנשלח מוגדר ב-server/crm-lead.js (schema: "pingwin.lead/1"), שטוח ומתועד:
#   { schema, lead_id, created_at, source, kind,
#     customer: { name, phone, email },
#     request:  { adults, children_ages, children_count, party_size, month, month_he,
#                 country, country_he, destination, departure_airport, nights,
#                 hebrew_kids_club, no_saturday_flights, preferences[], notes[] },
#     offer:    { hotel, resort, country, date, nights, room },   ← בלי מחיר (כלל אדום 3)
#     conversation: { id, transcript },
#     consent:  { privacy, at, text } }
# מי שממפה את זה ל-CRM ממפה פעם אחת; שינוי שמות שדות ישבור אינטגרציה חיה, ולכן
# tests/test-lead.js נועל את המבנה. מעבר ל-CRM אחר = עריכת crm-lead.js בלבד.
#
# ליד שלא הגיע ל-CRM (המערכת הייתה למטה) נרשם ב-server-data/leads-undelivered.jsonl
# במקום להיעלם בלוג. לראות מה תקוע: npm run leads:retry -- --list · לשלוח שוב: npm run leads:retry

# ---- מייל לנציג על כל ליד ----
# בלי אחד מהשניים (ווב-הוק או מייל) הלידים נשמרים רק לקובץ ואף אחד לא יודע עליהם.
# השרת מתריע על כך בעלייה.
# SMTP_URL=smtp://user:password@smtp.gmail.com:587
# LEAD_EMAIL_TO=info@pingwin.co.il,ops@pingwin.co.il
# LEAD_EMAIL_FROM=bot@pingwin.co.il
# LEAD_WEBHOOK_SECRET=

# ---- זיהוי חדרים מול מנוע ההזמנות של האתר ----
# השרת שואל את pingwin.co.il מה מזהי החדרים שלו, כדי שכפתור "המשך להזמנה"
# יבחר את החדר הנכון ולא רק ימלא תאריכים. אם האתר חוסם את השרת (403) —
# הכל ממשיך לעבוד, פשוט בלי בחירת חדר אוטומטית.
# בדיקה: npm run rooms
# SITE_ROOMS=off              לכיבוי מוחלט
# SITE_ROOMS_TTL_MS=21600000  כמה זמן לשמור רשימת חדרים (6 שעות)
# SITE_ROOMS_TIMEOUT_MS=6000

# ---- הגנות (שלב C) — כולן אופציונליות, ברירות המחדל מתאימות לאתר אחד ----
# RATE_CHAT_PER_MIN=30          תורים לכתובת IP בדקה
# RATE_CHAT_PER_HOUR=300
# RATE_LEAD_PER_10MIN=5         לידים לכתובת IP ב-10 דקות
# MAX_TURNS_PER_CHAT=80         אחרי זה הבוט מעביר לנציג
# CHAT_TIMEOUT_MS=25000
# MODEL_TIMEOUT_MS=20000        תקרה לכל קריאה בודדת למודל. שלוש הקריאות בתור
#                               חולקות תקציב זמן אחד לכל תור, כך שספק איטי לא
#                               יבזבז 20 שניות שלוש פעמים.
DAILY_BUDGET_USD=5            # מעל זה הבוט ממשיך לענות במצב offline (0 = בלי תקרה).
#                               ברירת מחדל פעילה בכוונה: בלי זה אין שום תקרה.
# MODEL_BREAKER_FAILURES=5      אחרי כמה כשלים רצופים לעבור ל-offline (מפסק זרם)
# MODEL_BREAKER_COOLDOWN_MS=60000  וכמה זמן להמתין לפני ניסיון נוסף
# TRUST_PROXY=1                 מספר הפרוקסי שלכם בשרשרת (1 = פרוקסי אחד).
#                               ה-IP נקרא מהסוף של x-forwarded-for, כי את ההתחלה
#                               הלקוח כותב בעצמו.
# CF_CONNECTING_IP=1            מאחורי Cloudflare — עדיף, כי היא דורסת את הכותרת
# ---- לוג השיחות ----
# מספרי טלפון ומיילים שלקוחות מקלידים מסוננים לפני הכתיבה. ימי שמירה (0 = בלי מחיקה):
# CHAT_LOG_DAYS=30
# LEAD_PII_DAYS=180             אחרי כמה ימים נמחקים שם/טלפון/מייל/תמליל מליד
#                               (הרשומה העסקית — מלון, תאריך, סוג — נשארת)
# LEAD_KEEP_DAYS=0              אחרי כמה ימים נמחקת הרשומה כולה (0 = לעולם לא)
# CHAT_LOG=off                  כיבוי מוחלט של הלוג
# Cloudflare Turnstile (חינם) — מונע בוטים. בלי המפתחות: כבוי.
# TURNSTILE_SITEKEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# ---- הגדרות שהיו בשימוש בקוד ולא היו מתועדות כאן ----
# OPENAI_PHRASE_MODEL=          מודל נפרד לשלב הניסוח (ברירת מחדל: אותו מודל)
# CARDS_DEFAULT=2              כמה הצעות על המסך (06/09): 2, והשלישית נפתחת בלחיצה על "עוד אפשרות". 3 = הפריסה הישנה
# REPLY_EDITOR=on              עורך התשובה (06/09): תורים בלי הצעות נכתבים כפסקה אחת מהחומר המאושר. off = שורות כמו קודם
# TRANSLATE=on                 אנגלית/רוסית/צרפתית/ערבית (06/09): ההודעה מתורגמת לעברית, התור רץ כרגיל, והתשובה מתורגמת חזרה (שתי קריאות מודל, עם שומרים). off = משפט קבוע בשפת הלקוח + טופס, כמו קודם
# COMPOSE_MAX_TOKENS=1200       תקרת טוקנים לעורך
# OFFICE_TZ=Asia/Jerusalem      אזור הזמן שלפיו נקבעות שעות המשרד בתשובות
# SITE_ROOMS_BASE=              בסיס לכתובת מנוע ההזמנות (לבדיקות מול סביבה אחרת)
# WORKBOOK=                     נתיב לקובץ ההתחייבויות עבור tests/run-tests.js

# ── מלאי: הדחיפה מהמשרד ────────────────────────────────────────────────
# קובץ ההתחייבויות יושב על כונן F: ברשת של פינגווין, והשרת לא מגיע לשם.
# מחשב במשרד מריץ את tools/push-availability.ps1 כל כמה שעות: הוא מפענח את
# הקובץ מקומית ושולח לכאן רק את המלאי הפנוי — בלי שום מידע אישי.
# הסוד הזה חייב להיות זהה ל-PINGWIN_BOT_TOKEN באותו מחשב. לייצר עם:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_TOKEN=
# אחרי כמה שעות בלי עדכון הבוט מפסיק לומר "נשאר חדר אחד" ומוסיף שורה
# שמסבירה שהזמינות משתנה (ברירת מחדל 12)
INVENTORY_STALE_HOURS=12
# דחיפה שמאבדת יותר מהחלק הזה מהמלאי נדחית כקובץ שבור (ברירת מחדל 0.5)
INVENTORY_MIN_RATIO=0.5

# AI_MODE=offline — הבוט עונה רק מהשכבה הדטרמיניסטית בעברית, בלי מודל, גם כשיש מפתחות.
# שימושי לבדיקות ולדמו בלי עלות. ברירת מחדל: לפי המפתחות שמוגדרים למעלה.
# AI_MODE=offline
