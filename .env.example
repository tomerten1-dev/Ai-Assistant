# העתק לקובץ בשם .env ומלא (לא נכנס ל-git)

# ---- מוח הבוט: מלא אחד מהם, או אף אחד ----
# בלי מפתח כלל הבוט עדיין עובד על שכבת העברית הדטרמיניסטית, בחינם.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# הדגם הזול מספיק לגמרי כאן; אפשר gpt-5.6-terra לאיכות גבוהה יותר
OPENAI_MODEL=gpt-5.6-luna

# חלופה: Claude (אם שני המפתחות קיימים, OpenAI מנצח)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ---- הגדרות ----
PORT=8787
# כמה שאלות מותר לבוט לשאול לפני שהוא חייב להציג תוצאות
MAX_QUESTIONS=3
# דומיינים שמותר להם לקרוא ל-API (פסיקים). לפרודקשן: להחליף את הכוכבית!
# ALLOWED_ORIGINS=https://www.pingwin.co.il,https://pingwin.co.il
ALLOWED_ORIGINS=*

# ---- לידים ----
# כל ליד נשמר ב-server-data/leads.jsonl, ובנוסף נשלח כ-JSON לכתובת הזו (Make / Zapier /
# Google Sheets / CRM). ריק = שמירה לדיסק בלבד. LEAD_WEBHOOK_SECRET חותם כל בקשה (HMAC-SHA256
# בכותרת x-signature) כדי שהצד המקבל יוכל לוודא שזה מאיתנו.
# LEAD_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxx

# ---- מייל לנציג על כל ליד ----
# בלי אחד מהשניים (ווב-הוק או מייל) הלידים נשמרים רק לקובץ ואף אחד לא יודע עליהם.
# השרת מתריע על כך בעלייה.
# SMTP_URL=smtp://user:password@smtp.gmail.com:587
# LEAD_EMAIL_TO=info@pingwin.co.il,ops@pingwin.co.il
# LEAD_EMAIL_FROM=bot@pingwin.co.il
# LEAD_WEBHOOK_SECRET=

# ---- זיהוי חדרים מול מנוע ההזמנות של האתר ----
# השרת שואל את pingwin.co.il מה מזהי החדרים שלו, כדי שכפתור "המשך להזמנה"
# יבחר את החדר הנכון ולא רק ימלא תאריכים. אם האתר חוסם את השרת (403) —
# הכל ממשיך לעבוד, פשוט בלי בחירת חדר אוטומטית.
# בדיקה: npm run rooms
# SITE_ROOMS=off              לכיבוי מוחלט
# SITE_ROOMS_TTL_MS=21600000  כמה זמן לשמור רשימת חדרים (6 שעות)
# SITE_ROOMS_TIMEOUT_MS=6000

# ---- הגנות (שלב C) — כולן אופציונליות, ברירות המחדל מתאימות לאתר אחד ----
# RATE_CHAT_PER_MIN=30          תורים לכתובת IP בדקה
# RATE_CHAT_PER_HOUR=300
# RATE_LEAD_PER_10MIN=5         לידים לכתובת IP ב-10 דקות
# MAX_TURNS_PER_CHAT=80         אחרי זה הבוט מעביר לנציג
# CHAT_TIMEOUT_MS=25000
# MODEL_TIMEOUT_MS=20000        תקרה לכל קריאה בודדת למודל
# DAILY_BUDGET_USD=5            מעל זה הבוט ממשיך לענות במצב offline עד חצות (0 = בלי תקרה)
# TRUST_PROXY=1                 מאחורי Cloudflare/nginx: לקרוא את ה-IP מ-x-forwarded-for
# ---- לוג השיחות ----
# מספרי טלפון ומיילים שלקוחות מקלידים מסוננים לפני הכתיבה. ימי שמירה (0 = בלי מחיקה):
# CHAT_LOG_DAYS=30
# CHAT_LOG=off                  כיבוי מוחלט של הלוג
# Cloudflare Turnstile (חינם) — מונע בוטים. בלי המפתחות: כבוי.
# TURNSTILE_SITEKEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# ── מלאי: הדחיפה מהמשרד ────────────────────────────────────────────────
# קובץ ההתחייבויות יושב על כונן F: ברשת של פינגווין, והשרת לא מגיע לשם.
# מחשב במשרד מריץ את tools/push-availability.ps1 כל כמה שעות: הוא מפענח את
# הקובץ מקומית ושולח לכאן רק את המלאי הפנוי — בלי שום מידע אישי.
# הסוד הזה חייב להיות זהה ל-PINGWIN_BOT_TOKEN באותו מחשב. לייצר עם:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_TOKEN=
# אחרי כמה שעות בלי עדכון הבוט מפסיק לומר "נשאר חדר אחד" ומוסיף שורה
# שמסבירה שהזמינות משתנה (ברירת מחדל 12)
INVENTORY_STALE_HOURS=12
# דחיפה שמאבדת יותר מהחלק הזה מהמלאי נדחית כקובץ שבור (ברירת מחדל 0.5)
INVENTORY_MIN_RATIO=0.5
